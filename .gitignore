# =========================================
#      Общие правила для всего проекта
# =========================================

# Игнорировать логи
*.log

# Игнорировать локальные конфигурационные файлы (из первого файла)
config.json

# Игнорировать виртуальные окружения Python
.venv/
venv/
/venv
/.venv

# Игнорировать кэш Python
__pycache__/

# Игнорировать базы данных SQLite, которые могут создаваться при локальной разработке
*.db
*.sqlite3

# =========================================
#      Правила для IDE (PyCharm, VSCode и др.)
# =========================================

# Игнорировать папки с настройками IDE
.idea/
.vscode/

# Игнорировать специфичные файлы IDE (из второго файла, но сгруппированы)
/shelf/
/workspace.xml
misc.xml
modules.xml
vcs.xml
*.iml
inspectionProfiles/
/options.py