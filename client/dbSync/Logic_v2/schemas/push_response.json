{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Push Response",
  "type": "object",
  "properties": {
    "statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": ["string", "integer", "null"]
          },
          "status": {
            "type": "string",
            "enum": ["COMPLETED", "FAILED", "ERROR"]
          },
          "error": {
            "type": ["string", "null"]
          }
        },
        "required": ["status"],
        "additionalProperties": false
      }
    }
  },
  "required": ["statuses"],
  "additionalProperties": false
}