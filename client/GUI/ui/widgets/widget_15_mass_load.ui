QCheckBox::indicator {
	width: 30px; 
	height: 30px;
}
QCheckBox::indicator:unchecked {
    image: url(:/icons/unchecked.png)
}
QCheckBox::indicator:checked {
    image: url(:/icons/checked.png)
}</string>
