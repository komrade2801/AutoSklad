	color: #FFFFFF;
	background-color: #2e4461;
	border-width: 2px;
	border-style: groove;
	border-color: #ff9923;
	border-radius: 0px;
	font-family: &quot;Roboto&quot;, Sans-serif;
}
QPushButton {
	color: #FFFFFF;
	background-color: #f09022;
	border-width: 0px;
	border-style: outset;
	border-color: #EAA657;
	border-radius: 8px;
	font-weight: 600;
    font-size: 25px;
	font-family: &quot;Roboto&quot;, Sans-serif;
}

QCheckBox {
	color: #FFFFFF;
	background-color: #2e4461;
    border-width: 0px;
    border-radius: 0px;
}
QCheckBox::indicator {
	width: 30px; 
	height: 30px;
}
QCheckBox::indicator:unchecked {
    image: url(:/icons/unchecked.png)
}
QCheckBox::indicator:checked {
    image: url(:/icons/checked.png)
}
